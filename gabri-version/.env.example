# Use ONE of these (OpenAI is used if it's the only key set)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
# If both keys are set, force OpenAI with:
# AI_PROVIDER=openai
# Mapbox public token (pk.…) for the 3D map
NEXT_PUBLIC_MAPBOX_TOKEN=
# Google Maps key with the Map Tiles API enabled, for the photoreal 3D view
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# DPS staff key: lets the staff tool clear a safety alert early (students can never clear alerts). Leave empty to disable.
DPS_STAFF_KEY=
