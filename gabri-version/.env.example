# Use ONE of these (OpenAI is used if it's the only key set)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
# If both keys are set, force OpenAI with:
# AI_PROVIDER=openai
# Mapbox public token (pk.…) for the 3D map
NEXT_PUBLIC_MAPBOX_TOKEN=
# Google Maps key with the Map Tiles API enabled, for the photoreal 3D view
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# DPS staff key: lets the staff tool clear a safety alert early (students can never clear alerts). Leave empty to disable.
DPS_STAFF_KEY=

# Sign in with Google + live Google Calendar sync (Google Cloud > APIs & Services > Credentials > OAuth client ID, type Web).
# Authorized redirect URI: http://localhost:3100/api/auth/google/callback  - also enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only accept accounts from this domain (e.g. usc.edu)
GOOGLE_ALLOWED_DOMAIN=
